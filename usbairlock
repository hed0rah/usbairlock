#!/usr/bin/env python3
"""usbairlock -- it shows you things... horrible things

    sudo ./usbairlock --auto             the usual run: withhold arrivals, record what types
    sudo ./usbairlock --auto -q          same, but trust and hide what is already plugged in
    sudo ./usbairlock                    withhold and watch, no recording
    ./usbairlock --observe               watch only, change nothing, no root needed
    sudo ./usbairlock --paranoid --auto  every protection on, plus recording
    ./usbairlock --status                what is protected right now, then exit
    ./usbairlock --diagnose              nothing appeared, why not
    ./usbairlock --list                  every device and its addresses
    ./usbairlock --list -q               ...without the hint. -qq for bare rows, to pipe
    ./usbairlock --write-config          print a config file to stdout

How deep to look at ONE device, shallowest first. Each takes an address from --list:

    sudo ./usbairlock --inspect ADDR     what it is, and whether to worry about it
    sudo ./usbairlock --hid ADDR         what a HID device declares it can send
    sudo ./usbairlock --describe ADDR    EVERY descriptor byte, decoded, with a receipt
                                         proving none were skipped. The deepest view
                                         there is, and more than `lsusb -v` prints

One monitor runs at a time. A second one is refused rather than allowed to fight it over
the same kernel settings. From any other terminal:

    sudo ./usbairlock --attach           watch the running monitor, read-only
    sudo ./usbairlock --authorize VID:PID  admit a device, and tell the monitor to trust it
    sudo ./usbairlock --forget           clear the allow list (it persists in /run)

Every protection is reversible and is restored when this exits, including on Ctrl-C
or a kill.
"""
import argparse, glob, json, os, queue, re, signal, sys, threading, time

VERSION = "0.9.0"

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from airlock import config as cfgmod, protect, usbinfo, capture as capmod, live as livemod
from airlock import ipc

C = dict(R="\033[31m", G="\033[32m", Y="\033[33m", B="\033[34m", C="\033[36m",
         M="\033[35m", D="\033[2m", W="\033[1m", N="\033[0m")
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = {k: "" for k in C}

LEVEL_COLOR = {"HIGH": C["R"] + C["W"], "MED": C["Y"], "LOW": C["D"]}

def p(s=""): print(s, flush=True)
_p = p          # stable alias: show_device shadows `p` with its `out` hook
def rule(ch="-", n=74): p(C["D"] + ch * n + C["N"])

def banner(cfg, results, cfg_path, observe):
    p()
    p(f"{C['W']}{C['C']}  usbairlock{C['N']}  {C['D']}it shows you things... horrible things{C['N']}")
    rule("=")
    if not usbinfo.have_lsusb():
        p(f"  {C['Y']}lsusb not found{C['N']}  {C['D']}devices are still detected from sysfs, but interface{C['N']}")
        p(f"                   {C['D']}descriptors are unavailable, so threat detection is limited.{C['N']}")
        p(f"                   {C['D']}install usbutils for the full picture.{C['N']}")
    if cfg_path: p(f"  {C['D']}config{C['N']}  {cfg_path}")
    else:        p(f"  {C['D']}config{C['N']}  built-in defaults  {C['D']}(./usbairlock --write-config > ~/.config/usbairlock/config){C['N']}")
    if observe:
        p(f"  {C['Y']}observe mode{C['N']}  {C['D']}nothing is being changed on this machine{C['N']}")
    elif not protect.is_root():
        p(f"  {C['Y']}not root{C['N']}      {C['D']}protections need sudo; watching only{C['N']}")
    p()
    p(f"  {C['W']}protections{C['N']}")
    # Fixed columns. The status word varies in length (off / ACTIVE / FAILED) and so do
    # the names, so without explicit widths the detail column staggers and the block
    # reads as broken. Colour codes are zero-width, so pad the PLAIN text and wrap after.
    NW, SW = 19, 6
    for name, wanted, ok, detail in results:
        if not wanted:      mark, word, col = "[ ]", "off",    C['D']
        elif ok:            mark, word, col = "[x]", "ACTIVE", C['G']
        else:               mark, word, col = "[!]", "FAILED", C['R']
        namecol = name.ljust(NW)
        wordcol = word.ljust(SW)
        if wanted and ok:   namecol = f"{C['W']}{namecol}{C['N']}"
        p(f"    {col}{mark}{C['N']} {namecol} {col}{wordcol}{C['N']} {C['D']}{detail}{C['N']}")
    rule()

def show_device(vp, name, cfg, first_seen=False, meta=None, out=None):
    # `out` routes these lines through the pinned-status logger, so the status block gets
    # repainted after each line instead of being scrolled off the screen.
    p = out or _p
    d = usbinfo.descriptors(vp)
    if meta:
        if meta.get("authorized") is not None: d["authorized"] = meta["authorized"]
        d["is_hub"] = meta.get("is_hub", False)
    known = usbinfo.KNOWN.get(vp, "")
    tag = f"{C['G']}{C['W']}+ ARRIVED{C['N']}" if first_seen else f"{C['D']}  present {C['N']}"
    hubtag = f" {C['B']}[HUB]{C['N']}" if d.get("is_hub") else ""
    addr = usbinfo.addr_of(meta.get("sysfs")) if meta else d.get("addr")
    at = f"{C['C']}{addr}{C['N']}  " if addr else ""
    p(f"  {time.strftime('%H:%M:%S')}  {tag}  {at}{C['W']}{vp}{C['N']}{hubtag}  {name or C['D']+'(no product string)'+C['N']}")
    if d.get("authorized") == "0":
        p(f"                 {C['Y']}UNAUTHORIZED{C['N']}  {C['D']}no interface objects, so nothing can bind or be claimed.{C['N']}")
        p(f"                               {C['D']}descriptors below are still readable over control transfers{C['N']}")
    if known: p(f"                 {C['C']}known:{C['N']} {known}")

    mode = cfg["monitor"].get("descriptors", "summary")
    if mode != "none":
        bits = []
        for k, lab in (("usb_version","usb"), ("speed","speed"), ("max_power","power"),
                       ("n_configs","configs"), ("authorized","authorized")):
            if d.get(k): bits.append(f"{lab}={d[k]}")
        # What the device claims about its own power. A hub asserting self-powered
        # while it has no supply is why the things behind it fail with nothing logged.
        pw = usbinfo.power_claim(d.get("cfg_attrs"))
        if pw:
            bits.append("self-powered" if pw["self_powered"] else "bus-powered")
            if pw["remote_wakeup"]: bits.append("remote-wakeup")
        if d.get("bcd_device"): bits.append(f"rev={d['bcd_device']}")
        # Configuration 0 is not "no configuration selected", it is the unconfigured
        # state, and it is what the kernel forces for an unauthorized device. Saying so
        # is more useful than leaving the reader to infer it from an empty interface list.
        if str(d.get("config_value") or "") == "0":
            bits.append("UNCONFIGURED")
        if bits: p(f"                 {C['D']}{'  '.join(bits)}{C['N']}")
        # Everything below is readable while the gate is shut, before anything binds.
        note = usbinfo.link_note(d.get("usb_version"), d.get("speed"))
        if note:
            p(f"                 {C['Y']}slow link{C['N']}  {C['D']}{note}{C['N']}")
        att = usbinfo.attachment(d.get("removable"))
        if att:
            p(f"                 {C['D']}port: {att}{C['N']}")
        qk = usbinfo.quirk_names(d.get("quirks"))
        if qk:
            p(f"                 {C['Y']}kernel quirks{C['N']}  {C['D']}{', '.join(qk)}"
              f"  -- the kernel has workarounds registered for this hardware{C['N']}")
        for k in ("manufacturer", "product", "serial"):
            if d.get(k): p(f"                 {C['D']}{k}: {d[k]}{C['N']}")
        if d.get("drivers"):
            p(f"                 {C['M']}drivers bound: {' '.join(d['drivers'])}{C['N']}")
        elif d.get("interfaces") and str(d.get("authorized")) != "0":
            p(f"                 {C['G']}UNBOUND{C['N']}  {C['D']}interfaces present, no driver attached{C['N']}")
        else:
            p(f"                 {C['G']}no drivers bound{C['N']}")
        for i in d.get("interfaces", []):
            c = usbinfo._i(i.get("cls"))
            nm = usbinfo.CLASSES.get(c, "?")
            extra = f"  {C['D']}{i['name']}{C['N']}" if mode == "full" and i.get("name") else ""
            # Endpoint ADDRESSES, not a count. This is the first thing you want on
            # bring-up, and it names the endpoint a capture would read.
            _e = [usbinfo.endpoint_label(x) for x in (i.get("eps") or [])]
            eps = ("  " + ", ".join(_e)) if _e else ""
            # Alternate settings are separate interface descriptors sharing a number.
            # Say which, or an audio interface looks like a duplicate of itself.
            alt = f" alt{i['alt']}" if str(i.get("alt", "0")) != "0" else ""
            p(f"                 {C['C']}if{i.get('num')}{alt}{C['N']} class 0x{c:02x} {nm:16s}"
              f" sub={i.get('sub')} proto={i.get('proto')}{eps}{extra}")

    th = usbinfo.threats(d)
    if th:
        worst = "HIGH" if any(t[0]=="HIGH" for t in th) else ("MED" if any(t[0]=="MED" for t in th) else "LOW")
        for lvl, headline, why in th:
            p(f"                 {LEVEL_COLOR[lvl]}[{lvl}]{C['N']} {headline}")
            p(f"                        {C['D']}{why}{C['N']}")
        if worst == "HIGH" and cfg["monitor"].get("bell_on_high", True):
            sys.stdout.write("\a"); sys.stdout.flush()
    else:
        p(f"                 {C['G']}no suspect claims{C['N']}")
    if first_seen:
        p(f"                 {C['D']}authorize: sudo ./usbairlock --authorize {vp}{C['N']}")
    p()
    return d

def do_diagnose(porc=False):
    """Why did nothing appear? Separates the three outcomes that look identical."""
    if not porc:
        p(f"\n  {C['W']}diagnosis{C['N']}")
        rule()
    devs = usbinfo.snapshot()
    serial = sorted(glob.glob("/dev/ttyACM*") + glob.glob("/dev/ttyUSB*"))
    if porc:
        porcelain("diag", devices=len(devs), serial_ports=len(serial),
                  serial=",".join(serial) or "none")
    else:
        p(f"  usb devices (excluding root hubs) : {len(devs)}")
        p(f"  serial ports                      : {' '.join(serial) or 'none'}")

    # the kernel's own view is the deciding evidence
    import subprocess
    r = subprocess.run("dmesg", shell=True, capture_output=True, text=True)
    log = r.stdout
    if r.returncode != 0:
        r = subprocess.run("sudo -n dmesg", shell=True, capture_output=True, text=True)
        log = r.stdout if r.returncode == 0 else ""
    if not log:
        restrict = "?"
        try: restrict = open("/proc/sys/kernel/dmesg_restrict").read().strip()
        except Exception: pass
        if porc:
            porcelain("diag", kernel_log="restricted", dmesg_restrict=restrict)
        else:
            p(f"  kernel log                        : {C['Y']}restricted{C['N']} (dmesg_restrict={restrict})")
            p(f"  {C['D']}rerun with sudo to see enumeration attempts{C['N']}")
    else:
        hits = [l for l in log.splitlines() if re.search(
            r'usb \d|new (full|high|low)-speed|device descriptor|not accepting address|over-?current|disconnect', l, re.I)][-6:]
        if porc:
            porcelain("diag", kernel_log="readable", usb_events=len(hits))
            for h in hits:
                porcelain("kmsg", line=h.strip().replace("\t", " "))
            return 0
        if hits:
            p(f"  kernel log                        : {len(hits)} recent USB event(s)")
            for h in hits: p(f"    {C['D']}{h[-110:]}{C['N']}")
        else:
            p(f"  kernel log                        : {C['R']}no USB events at all{C['N']}")
            p()
            p(f"  {C['W']}That is the answer.{C['N']} The host never saw a connect attempt, so this is")
            p(f"  electrical, not software. Drivers, permissions and boot mode are all ruled out.")
            p(f"    {C['C']}1.{C['N']} charge-only cable, by far the most common cause")
            p(f"    {C['C']}2.{C['N']} connector orientation: USB-C carries two D+/D- pairs, a device wires one")
            p(f"    {C['C']}3.{C['N']} the board's USB-C is wired for power only, and wants a UART adapter")
            p(f"    {C['C']}4.{C['N']} firmware holding the USB pins. On an ESP32-C3 native USB is GPIO18/19;")
            p(f"       hold BOOT (GPIO9), tap RESET, release, to force the ROM bootloader")
    p()
    return 0

def do_arm(cfg, disarm=False, porc=False):
    if not protect.is_root():
        p(f"  {C['R']}needs root{C['N']}"); return 1
    if disarm:
        for name,(fn,desc) in protect.REGISTRY.items():
            try: fn(False)
            except Exception: pass
        for r in glob.glob("/sys/bus/usb/devices/usb*"):
            for f in ("authorized_default","interface_authorized_default"):
                try: open(os.path.join(r,f),"w").write("1")
                except Exception: pass
        for a in glob.glob("/sys/bus/usb/devices/*/authorized"):
            try: open(a,"w").write("1")
            except Exception: pass
        if porc: porcelain("disarm", granted=1)
        else: p(f"  {C['G']}GRANTED{C['N']}  authorization restored, drivers bind normally")
        return 0
    results = protect.apply(cfg["protections"])
    protect._saved.clear()      # deliberately persistent: this is the one-shot mode
    for name, wanted, ok, detail in results:
        if porc:
            porcelain("protection", name=name, wanted=int(bool(wanted)),
                      active=int(bool(ok)) if wanted else 0, persistent=1)
        elif wanted:
            mark = f"{C['G']}ACTIVE{C['N']}" if ok else f"{C['R']}FAILED{C['N']}"
            p(f"  {mark}  {name:16s} {C['D']}{detail}{C['N']}")
    if not porc:
        p(f"  {C['Y']}these persist until you run --disarm{C['N']}")
    return 0

def do_inspect(cfg, target=None, porc=False):
    snap = usbinfo.snapshot()
    if target:
        # Match on ADDRESS, not just vid:pid, so two identical devices are separable.
        want = set(usbinfo.resolve(target))
        hits = [m for m in snap.values() if m.get("sysfs") in want]
    else:
        hits = list(snap.values())
    if not hits:
        p(f"  no device matching {target or '(any)'}")
        if target: p(f"  {C['D']}./usbairlock --list shows every address{C['N']}")
        return 1
    worst = 0
    for m in hits:
        if porc:
            d = usbinfo.descriptors(m["id"])
            th = usbinfo.threats(d)
            porcelain("present", addr=usbinfo.addr_of(m.get("sysfs")), id=m["id"],
                      name=(m.get("name") or "").replace("\t", " "),
                      authorized=m.get("authorized"),
                      drivers=",".join(d.get("drivers") or []) or "none",
                      worst=usbinfo.rules.worst(set(l for l, _, _ in th)) or "none")
            for lvl, headline, _ in th:
                porcelain("threat", addr=usbinfo.addr_of(m.get("sysfs")),
                          id=m["id"], level=lvl, claim=headline)
        else:
            d = show_device(m["id"], m["name"], cfg, meta=m)
            th = usbinfo.threats(d)
        for lvl, _, _ in th:
            worst = max(worst, {"LOW":1,"MED":2,"HIGH":3}[lvl])
    return 2 if worst >= 3 else 0

def do_capture(cfg, target, iface, ep, seconds):
    """Read what a HID device types, without letting it reach the system."""
    if not protect.is_root():
        p(f"  {C['R']}--capture needs root{C['N']} (it claims the interface through usbfs)"); return 1
    d = usbinfo.descriptors(target)
    p(f"\n  {C['W']}capture{C['N']}  {target}  {C['D']}{d.get('product') or ''}{C['N']}")
    if d.get("drivers"):
        p(f"  {C['R']}already bound to {' '.join(d['drivers'])}{C['N']}  "
          f"{C['D']}its reports are reaching this machine{C['N']}")
        return 1
    try:
        steps, restore = capmod.prepare(target, iface)
    except RuntimeError as e:
        p(f"  {C['R']}{e}{C['N']}"); return 1
    for st in steps:
        colour = C['R'] if st.startswith("WARNING") else (C['Y'] if st.startswith("NOTE") else C['G'])
        p(f"  {colour}+{C['N']} {st}")
    p(f"  {C['G']}no kernel driver bound{C['N']}  {C['D']}usbhid is not loaded, so nothing can turn these{C['N']}")
    p(f"                         {C['D']}reports into input events. they land here instead.{C['N']}")
    p(f"  {C['D']}interface {iface}, endpoint 0x{ep:02x}. ctrl-c to stop.{C['N']}")
    rule()
    line, last = "", [time.time()]
    def flush():
        if line.strip():
            p(f"  {C['Y']}{C['W']}typed:{C['N']} {line}")
    try:
        def lost(): p(f"  {C['Y']}re-enumerated{C['N']}  {C['D']}reconnecting{C['N']}")
        def found(): p(f"  {C['G']}reattached{C['N']}")
        for ts, text, chords in capmod.capture_forever(target, iface, ep,
                                                       on_lost=lost, on_found=found):
            gap = ts - last[0]; last[0] = ts
            for ch in chords:
                p(f"  {time.strftime('%H:%M:%S')}  {C['R']}{C['W']}CHORD{C['N']}  {ch}"
                  f"   {C['D']}+{gap*1000:.0f}ms{C['N']}")
            if text:
                line += text
                if "\n" in text:
                    for seg in line.split("\n")[:-1]:
                        p(f"  {time.strftime('%H:%M:%S')}  {C['G']}LINE {C['N']}  {seg}")
                    line = line.split("\n")[-1]
                else:
                    sys.stdout.write(f"\r  {time.strftime('%H:%M:%S')}  {C['C']}keys {C['N']}  {line}")
                    sys.stdout.flush()
    except KeyboardInterrupt:
        p(); flush()
    except RuntimeError as e:
        p(f"  {C['R']}{e}{C['N']}"); return 1
    except OSError as e:
        p(f"  {C['R']}usb error: {e}{C['N']}"); return 1
    finally:
        try:
            restore(); p(f"  {C['D']}restored usbhid and the prior authorization state.{C['N']}")
        except Exception: pass
    return 0

def porcelain(kind, **kw):
    """One tab-separated record per line. Stable field order, no colour, no layout.

    Meant to be parsed. The pretty output is free to change; this is not.
    fields: kind, then key=value pairs in the order given.
    """
    parts = [kind] + [f"{k}={v}" for k, v in kw.items()]
    print("\t".join(str(x).replace("\t", " ") for x in parts), flush=True)

def _hid_interfaces(d):
    return [i for i in d.get("interfaces", []) if usbinfo.rules.to_int(i.get("cls")) == 0x03]

def _drop_capture(capturing, vp, release=False):
    """Remove every capture for a vid:pid, optionally stopping it first.

    The dict is keyed by address (`1-1`) when one is resolvable and by vid:pid only as
    a fallback, but the capture queue reports by vid:pid. Popping by vid:pid therefore
    missed the usual case, leaked the entry, and left `(addr or vp) not in capturing`
    permanently true so the device could never be captured again.
    """
    dropped = []
    for k in [k_ for k_, v_ in capturing.items() if v_[2] == vp or k_ == vp]:
        _t, ev, _vp = capturing.pop(k)
        if release: ev.set()
        dropped.append(k)
    return dropped


def _start_capture(vp, d, q, stop, target=None):
    """Record what a HID arrival types, in a thread, into the shared queue.

    Only fired for devices that actually claim HID, because prepare() removes usbhid
    globally and that is not something to do speculatively for a flash drive.

    Returns (thread, mine, vp). `mine` stops just this capture: --authorize on a device
    being captured has to release that device and nothing else, and the shared `stop`
    event cannot express that. `vp` rides along because the dict is keyed by ADDRESS
    while everything else refers to devices by vid:pid.
    """
    ifs = _hid_interfaces(d)
    iface = int(ifs[0].get("num", 0)) if ifs else 0
    ep = 0x81 + iface
    mine = threading.Event()
    halt = lambda: mine.is_set() or stop.is_set()
    def run():
        try:
            for ts, text, chords in capmod.capture_forever(
                    target or vp, iface, ep,
                    on_lost=lambda: q.put(("note", vp, "re-enumerated, reconnecting")),
                    on_found=lambda: q.put(("note", vp, "reattached")),
                    on_prepared=lambda st: [q.put(("note", vp, s_)) for s_ in st],
                    should_stop=halt):
                if halt(): return
                if text:   q.put(("keys", vp, text))
                for c_ in chords: q.put(("chord", vp, c_))
        except capmod.Gone as e:
            q.put(("gone", vp, str(e)))
        except RuntimeError as e:
            # "did not come back" after a disconnect means the device was unplugged,
            # which is an ending, not a failure. Only say failed when it actually is.
            q.put(("gone" if "did not come back" in str(e) else "err", vp, str(e)))
        except Exception as e:
            q.put(("err", vp, str(e)))
    t = threading.Thread(target=run, daemon=True)
    t.start()
    return t, mine, vp

def do_describe(spec):
    """Everything in a device's descriptors, decoded, with every byte accounted for.

    The bar here is `lsusb -v`, which prints the same bytes. What this adds:
      - class-specific descriptors are counted and named rather than dumped raw
      - alternate settings are shown as themselves, not collapsed
      - the HID report descriptor is DECODED, not hex
      - what only the kernel knows: physical port, removable, quirks, live drivers
      - a byte count, so you can see nothing was skipped
    """
    d = usbinfo.sysfs_for(spec)
    if not d:
        p(f"\n  {C['R']}no device matches {spec}{C['N']}"); return 1
    try:
        with open(os.path.join(d, "descriptors"), "rb") as fh:
            blob = fh.read()
    except OSError as e:
        p(f"\n  {C['R']}cannot read descriptors: {e}{C['N']}"); return 1

    x = usbinfo.rules.parse_descriptors(blob)
    dev = usbinfo.descriptors(spec)
    addr = usbinfo.addr_of(d)
    p()
    p(f"  {C['W']}{addr}{C['N']}  {C['W']}{x.get('id','?')}{C['N']}  "
      f"{C['D']}{dev.get('product') or '(no product string)'}{C['N']}")
    rule()

    # ---- device -----------------------------------------------------------------
    p(f"  {C['C']}device{C['N']}")
    cls = usbinfo._i(x.get("dev_class"))
    clsname = "per-interface" if cls == 0 else usbinfo.CLASSES.get(cls, "?")
    rows = [("usb", f"{x.get('usb_version')}  {usbinfo.speed_name(dev.get('speed'))}"),
            ("class", f"0x{cls:02x}  {clsname}"),
            ("ep0 max packet", f"{x.get('ep0_size')} bytes"),
            ("revision", x.get("bcd_device")),
            ("configurations", x.get("n_configs"))]
    for k in ("manufacturer", "product", "serial"):
        if dev.get(k): rows.append((k, dev[k]))
    att = usbinfo.attachment(dev.get("removable"))
    if att: rows.append(("port", att))
    loc = usbinfo.port_location(d)
    if loc: rows.append(("physical", loc))
    qk = usbinfo.quirk_names(dev.get("quirks"))
    rows.append(("kernel quirks", ", ".join(qk) if qk else "none"))
    if dev.get("drivers"): rows.append(("drivers bound", " ".join(dev["drivers"])))
    note = usbinfo.link_note(x.get("usb_version"), dev.get("speed"))
    if note: rows.append(("link", note))
    for k, v in rows:
        if v: p(f"      {C['D']}{k:<16}{C['N']} {v}")

    # ---- configurations ---------------------------------------------------------
    for cfg in x.get("configs", []):
        pw = usbinfo.power_claim(cfg.get("cfg_attrs")) or {}
        p()
        p(f"  {C['C']}configuration {cfg.get('value')}{C['N']}  {C['D']}"
          f"{cfg.get('n_interfaces')} interfaces, {cfg.get('max_power')}, "
          f"{'self-powered' if pw.get('self_powered') else 'bus-powered'}"
          f"{', remote wakeup' if pw.get('remote_wakeup') else ''}{C['N']}")
        for a in x.get("associations", []):
            p(f"      {C['D']}association: interfaces {a['first']}+{a['count']} "
              f"act as one function (class 0x{usbinfo._i(a['cls']):02x}){C['N']}")
        for i in x.get("interfaces", []):
            if cfg.get("value") and i.get("config") not in (None, cfg.get("value")):
                continue
            ic = usbinfo._i(i.get("cls"))
            nm = usbinfo.CLASSES.get(ic, "?")
            neps = len(i.get("eps") or [])
            p(f"      {C['C']}if{i['num']} alt{i['alt']}{C['N']}  0x{ic:02x} {nm:14s} "
              f"{C['D']}sub={i.get('sub')} proto={i.get('proto')}  "
              f"{neps} endpoint{'' if neps == 1 else 's'}{C['N']}")
            for e in i.get("eps") or []:
                p(f"          {C['D']}{usbinfo.endpoint_label(e, verbose=True)}{C['N']}")
            ex = i.get("extra") or []
            if ex:
                by = {}
                for r in ex: by[r["name"]] = by.get(r["name"], 0) + 1
                summ = ", ".join(f"{v}x {k}" if v > 1 else k for k, v in sorted(by.items()))
                p(f"          {C['D']}+ {summ}{C['N']}")
            rd = (dev.get("report_descriptors") or {}).get(str(i.get("num")))
            if rd:
                pr = usbinfo.rules.parse_report_descriptor(rd)
                caps = usbinfo.rules.describe_capability(pr)
                p(f"          {C['M']}report descriptor{C['N']} {C['D']}{len(rd)} bytes: "
                  f"declares {', '.join(caps) or 'no input reports'}{C['N']}")

    # ---- what it claims ----------------------------------------------------------
    th = usbinfo.threats(dev)
    if th:
        p()
        p(f"  {C['C']}claims{C['N']}")
        for lvl, headline, why in th:
            col = C['R'] if lvl == "HIGH" else (C['Y'] if lvl == "MED" else C['D'])
            p(f"      {col}[{lvl}]{C['N']} {headline}")
            p(f"             {C['D']}{why}{C['N']}")

    # ---- the receipt -------------------------------------------------------------
    p()
    ok = x["parsed_bytes"] == x["total_bytes"] and not x["truncated"]
    col = C['G'] if ok else C['Y']
    p(f"  {col}{x['parsed_bytes']}/{x['total_bytes']} bytes{C['N']} {C['D']}in "
      f"{x['descriptor_count']} descriptors"
      f"{', all accounted for' if ok else ', SOME NOT PARSED'}{C['N']}")
    p()
    return 0


def do_hid(spec, porc=False):
    """Dump what a HID interface declares it can send.

    The report descriptor is normally read as part of a verdict. This exposes it on its
    own, because "what reports does this thing produce" is the first question when
    working out how to talk to a controller, a foot pedal or a barcode scanner -- and it
    has nothing to do with whether the device is trustworthy.

    Needs the interface to have no driver bound: the kernel returns EBUSY for a control
    transfer aimed at an interface a driver owns. Which is the state the airlock creates,
    so --paranoid in another terminal is the way to read a device the system has claimed.
    """
    if not protect.is_root():
        p(f"  {C['R']}needs root{C['N']}  {C['D']}reading a descriptor is a usbfs control transfer{C['N']}")
        return 1
    d = usbinfo.sysfs_for(spec)
    if not d:
        if porc: porcelain("hid", spec=spec, error="no such device")
        else: p(f"\n  {C['R']}no device matches {spec}{C['N']}")
        return 1
    addr = usbinfo.addr_of(d)
    hits = 0
    if not porc:
        p(); p(f"  {C['W']}{addr}{C['N']}  {C['D']}HID report descriptors{C['N']}"); rule()
    for i in sorted(glob.glob(os.path.join(d, "*:*"))):
        if usbinfo._attr(i, "bInterfaceClass") != "03":
            continue
        num = usbinfo._attr(i, "bInterfaceNumber")
        try: num_i = int(num, 16)
        except (TypeError, ValueError): continue
        drv = os.path.join(i, "driver")
        if os.path.exists(drv):
            held = os.path.basename(os.path.realpath(drv))
            if porc: porcelain("hid", addr=addr, iface=num_i, error="claimed by " + held)
            else: p(f"  if{num_i}  {C['Y']}cannot read{C['N']}  {C['D']}{held} holds this interface. "
                    f"Run a monitor with --paranoid, or unbind it{C['N']}")
            hits += 1
            continue
        raw = capmod.report_descriptor(addr, num_i)
        if not raw:
            if porc: porcelain("hid", addr=addr, iface=num_i, error="no descriptor returned")
            else: p(f"  if{num_i}  {C['D']}no report descriptor returned{C['N']}")
            hits += 1
            continue
        parsed = usbinfo.rules.parse_report_descriptor(raw)
        caps = usbinfo.rules.describe_capability(parsed)
        if porc:
            porcelain("hid", addr=addr, iface=num_i, bytes=len(raw),
                      pages=",".join("0x%04x" % x for x in parsed["pages"]) or "-",
                      declares=",".join(caps) or "-",
                      truncated=int(bool(parsed["truncated"])))
            for lvl, headline, _why in usbinfo.rules.capability_threats(parsed):
                porcelain("hid_threat", addr=addr, iface=num_i, level=lvl, claim=headline)
        else:
            p(f"  {C['C']}if{num_i}{C['N']}  {C['D']}{len(raw)} bytes{C['N']}")
            p(f"      {C['W']}declares{C['N']}  {', '.join(caps) or 'no input reports'}")
            if parsed["pages"]:
                p(f"      {C['D']}pages     {', '.join(usbinfo.rules.page_name(x) for x in parsed['pages'])}{C['N']}")
            if parsed["truncated"]:
                p(f"      {C['Y']}truncated{C['N']}  {C['D']}the descriptor does not fully decode{C['N']}")
            for lvl, headline, why in usbinfo.rules.capability_threats(parsed):
                col = C['R'] if lvl == "HIGH" else C['Y']
                p(f"      {col}[{lvl}]{C['N']} {headline}")
                p(f"             {C['D']}{why}{C['N']}")
            # the raw bytes, because anyone reverse engineering one wants them
            hexs = " ".join("%02x" % b for b in raw)
            for off in range(0, len(hexs), 96):
                p(f"      {C['D']}{hexs[off:off+96]}{C['N']}")
        hits += 1
    if not hits:
        if porc: porcelain("hid", addr=addr, error="no HID interfaces")
        else: p(f"  {C['D']}no HID interfaces on this device{C['N']}")
    if not porc: p()
    return 0


def do_forget(porc=False):
    """Clear the shared allow list.

    Deliberately does NOT touch a running monitor: it already holds its allow set in
    memory and only ever adds to it, so un-trusting a device mid-session is not a thing
    this can honestly promise. Say so rather than implying otherwise.
    """
    had = ipc.forget_allow()
    if porc:
        for vp in sorted(had):
            porcelain("forgot", id=vp)
        porcelain("forget", count=len(had))
        return 0
    if not had:
        p(f"\n  {C['D']}allow list was already empty.{C['N']}")
        return 0
    p(f"\n  {C['G']}forgot {len(had)} device(s){C['N']}  {C['W']}{' '.join(sorted(had))}{C['N']}")
    if ipc.holder_pid():
        p(f"  {C['Y']}a monitor is running{C['N']} {C['D']}and keeps its own copy in memory. "
          f"restart it to pick this up.{C['N']}")
    return 0


def do_status(porc=False):
    if not porc:
        p(f"\n  {C['W']}current state{C['N']}")
        rule()
    for r in sorted(glob.glob("/sys/bus/usb/devices/usb*")):
        dev = open(os.path.join(r,"authorized_default")).read().strip()
        ifp = os.path.join(r,"interface_authorized_default")
        ifd = open(ifp).read().strip() if os.path.exists(ifp) else "n/a"
        # The kernel's own vocabulary, not invented words. sysfs calls it authorized,
        # drivers are bound or unbound, and this tool withholds authorization. Anyone
        # debugging will grep for those terms, so the labels should match them. Open and
        # closed were ambiguous anyway: in security "open" reads as exposed, in an airlock
        # it reads as things-get-through.
        # BOTH values decide the verdict. Reading only authorized_default reported
        # GRANTED while the interface gate was actively withholding, which is the
        # default configuration, so the status lied in the most common case.
        if dev == "0":     gate = f"{C['G']}WITHHELD{C['N']} device"
        elif ifd == "0":   gate = f"{C['G']}WITHHELD{C['N']} interface"
        else:              gate = f"{C['Y']}GRANTED{C['N']}"
        if porc:
            porcelain("gate", root=os.path.basename(r), authorized_default=dev,
                      interface_authorized_default=ifd,
                      withheld=int(dev == "0" or ifd == "0"))
        else:
            p(f"  {os.path.basename(r):6s} authorized_default={dev} "
              f"interface_authorized_default={ifd}   {gate}")
    if porc:
        for _k, meta in sorted(usbinfo.snapshot().items()):
            d0 = usbinfo.descriptors(meta["id"])
            porcelain("present", addr=usbinfo.addr_of(meta.get("sysfs")), id=meta["id"],
                      name=(meta.get("name") or "").replace("\t", " "),
                      authorized=meta.get("authorized"),
                      drivers=",".join(d0.get("drivers") or []) or "none",
                      worst=usbinfo.rules.worst(
                          set(l for l, _, _ in usbinfo.threats(d0))) or "none")
        return 0
    p()
    for vp_key, meta in usbinfo.snapshot().items():
        show_device(meta["id"], meta["name"], {"monitor":{"descriptors":"summary"}})
    return 0

def do_replay(a, path):
    """Render a --log file. The journal speaks the viewer's wire format, so this is
    do_attach's renderer pointed at a file instead of a socket.

    Deliberately linear. Replaying the pinned status block would flicker a session's
    history through one five-line box and tell you nothing; the log lines in order are
    the record. `status` events are skipped for the same reason, they are derived state.
    """
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError as e:
        p(f"  {C['R']}cannot read {path}: {e}{C['N']}")
        return 1
    n, worst, sessions = 0, 0, 0
    with fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try: ev = json.loads(raw)
            except ValueError:
                continue                      # a truncated last line is normal after a kill
            kind = ev.get("ev")
            n += 1
            if a.porcelain:
                porcelain(kind or "event", **{k: v for k, v in ev.items() if k != "ev"})
                continue
            when = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ev.get("t", 0)))
            if kind == "session":
                sessions += 1
                rule()
                # Everything below is rendered through safe_text. A log is a file: it
                # can come from another machine, from an older build that did not
                # sanitize, or from an attacker. Replaying it must not hand a terminal
                # escape sitting inside that file straight to this terminal.
                _s = usbinfo.safe_text
                p(f"  {C['W']}session{C['N']}  {when}  {C['D']}pid {_s(ev.get('pid','?'))}{C['N']}")
                p(f"    {C['D']}argv       {_s(ev.get('argv',''))}{C['N']}")
                p(f"    {C['D']}protections {_s(', '.join(ev.get('protections') or []) or 'none')}{C['N']}")
                rule()
            elif kind == "present":
                w = ev.get("worst") or "none"
                col = C['R'] if w == "HIGH" else C['Y'] if w == "MED" else C['D']
                worst = max(worst, {"HIGH": 3, "MED": 2, "LOW": 1}.get(w, 0))
                p(f"  {C['D']}baseline{C['N']} {usbinfo.safe_text(ev.get('addr') or '?'):<8s} {usbinfo.safe_text(ev.get('id'))}  "
                  f"{col}{w:<5s}{C['N']} {C['D']}auth={ev.get('authorized')} "
                  f"drivers={ev.get('drivers')}{C['N']}")
            elif kind == "log":
                p("  " + usbinfo.safe_text(ev.get("line", ""), limit=400))
    if not a.porcelain:
        p()
        p(f"  {C['D']}{n} event(s), {sessions} session(s) from {path}{C['N']}")
    return 2 if worst >= 3 else 0


def do_attach(a):
    """Watch a monitor that is already running, without touching a single kernel knob."""
    pid = ipc.holder_pid()
    if not pid:
        p(f"  {C['Y']}no monitor is running{C['N']}")
        p(f"  {C['D']}start one with: sudo ./usbairlock --auto{C['N']}")
        return 1
    if not protect.is_root():
        p(f"  {C['R']}--attach needs root{C['N']}")
        # Not an arbitrary restriction. The stream replays captured HID reports.
        p(f"  {C['D']}the stream carries captured keystrokes, so the socket is root-only{C['N']}")
        return 1
    p(f"  {C['W']}attached{C['N']} {C['D']}to monitor pid {pid}, read-only.{C['N']}")
    p(f"  {C['D']}ctrl-c detaches. the monitor keeps running and keeps holding.{C['N']}")
    rule()
    rc = 0
    with livemod.Pinned(height=5, enabled=not a.plain) as pin:
        out = pin.log if pin.enabled else _p
        def on_event(ev):
            kind = ev.get("ev")
            if kind == "log":
                out(ev.get("line", ""))
            elif kind == "status" and pin.enabled:
                pin.set(list(ev.get("lines") or []))
        try:
            rc = ipc.attach(on_event)
            gone = True
        except KeyboardInterrupt:
            gone = False
        except OSError as e:
            p(f"  {C['R']}could not attach: {e}{C['N']}")
            return 1
    p(f"  {C['D']}" + ("the monitor exited." if gone else "detached, monitor still running.")
      + f"{C['N']}")
    return rc


def do_list(a):
    """Every device on the bus with its low-level addresses. Reads sysfs, not lsusb.

    Root hubs are included rather than filtered out: they are where the gates are
    actually written, so a listing that hides them hides the thing --status changes.
    """
    import glob as _g
    rows = []
    for d in sorted(_g.glob("/sys/bus/usb/devices/*/")):
        vid, pid = usbinfo._attr(d, "idVendor"), usbinfo._attr(d, "idProduct")
        if not (vid and pid):
            continue                       # an interface dir, not a device
        bus, dev = usbinfo._attr(d, "busnum"), usbinfo._attr(d, "devnum")
        drivers, iclass = [], []
        for i in sorted(glob.glob(os.path.join(d, "*:*"))):
            c = usbinfo._attr(i, "bInterfaceClass")
            if c: iclass.append(c)
            drv = os.path.join(i, "driver")
            if os.path.exists(drv):
                drivers.append(os.path.basename(os.path.realpath(drv)))
        name = " ".join(x for x in (usbinfo._attr(d, "manufacturer"),
                                    usbinfo._attr(d, "product")) if x)
        rows.append({
            "addr": usbinfo.addr_of(d),
            "bus": f"{int(bus):03d}" if (bus or "").isdigit() else (bus or "?"),
            "devnum": f"{int(dev):03d}" if (dev or "").isdigit() else (dev or "?"),
            "node": (f"/dev/bus/usb/{int(bus):03d}/{int(dev):03d}"
                     if (bus or "").isdigit() and (dev or "").isdigit() else "-"),
            "id": f"{vid}:{pid}",
            "class": usbinfo._attr(d, "bDeviceClass") or "00",
            "iclass": ",".join(sorted(set(iclass))) or "-",
            "driver": ",".join(sorted(set(drivers))) or "none",
            "auth": usbinfo._attr(d, "authorized") or "?",
            "hub": "1" if usbinfo._attr(d, "bDeviceClass") == "09" else "0",
            "parent": usbinfo.parent_of(usbinfo.addr_of(d)) or "-",
            "depth": str(usbinfo.depth_of(usbinfo.addr_of(d))),
            "name": (name or "-").replace("\t", " "),
        })

    # A device behind an unauthorized hub is enumerated and unreachable, and nothing
    # says so anywhere. Walk up the tree once and mark them, because "allowed it and
    # nothing happened" is the confusing case this listing exists to explain.
    auth_by = {r["addr"]: r["auth"] for r in rows}
    for r in rows:
        r["stranded"] = usbinfo.stranded_by(r["addr"], auth_by) or "-"
        r["blind"] = "1" if usbinfo.blinds_downstream(
            r["addr"], auth_by, r["hub"] == "1") else "0"

    # parent before child, so indentation reads as the tree it is, and siblings in
    # port order rather than string order: 1-5 belongs above 1-14, not below it.
    rows.sort(key=lambda r: usbinfo.sort_key(r["addr"]))
    ordered, seen_addr = [], set()
    def walk(parent):
        for r in rows:
            if r["parent"] == parent and r["addr"] not in seen_addr:
                seen_addr.add(r["addr"]); ordered.append(r); walk(r["addr"])
    walk("-")
    for r in rows:                       # anything orphaned by an odd name
        if r["addr"] not in seen_addr:
            seen_addr.add(r["addr"]); ordered.append(r)
    rows = ordered
    if a.porcelain:
        for r in rows:
            porcelain("dev", **r)
        return 0
    if a.quiet < 2:
        p()
        p(f"  {C['D']}addr           bus/dev   id           ifcls   driver      auth  name{C['N']}")
        rule()
    for r in rows:
        auth = f"{C['G']}1{C['N']}" if r["auth"] == "1" else f"{C['R']}0{C['N']}"
        tag = f"{C['B']}[HUB]{C['N']} " if r["hub"] == "1" else ""
        d0 = int(r["depth"])
        indent = "" if d0 == 0 else ("  " * (d0 - 1)) + "\u2514 "
        shown = (indent + r["addr"])[:14]
        p(f"  {shown:<14s} {r['bus']}/{r['devnum']}   {C['W']}{r['id']}{C['N']}    "
          f"{r['iclass']:<7s} {r['driver']:<11s} {auth}     {tag}{r['name'][:30]}")
        if r["blind"] == "1":
            p(f"  {' ' * 14} {C['Y']}opaque{C['N']} {C['D']}withheld hub: nothing behind it can "
              f"enumerate, so this listing cannot show what is{C['N']}")
        if r["stranded"] != "-":
            p(f"  {' ' * 14} {C['R']}unreachable{C['N']} {C['D']}behind unauthorized hub "
              f"{r['stranded']}, nothing below it can enumerate{C['N']}")
    if a.quiet >= 1:
        return 0
    example = next((r["addr"] for r in rows if r["hub"] == "0"), rows[0]["addr"] if rows else "1-1")
    p()
    p(f"  {C['D']}{len(rows)} device(s). look closer, shallowest first:{C['N']}  "
      f"{C['D']}sudo ./usbairlock --{{inspect,hid,describe}} {example}{C['N']}")
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--config"); ap.add_argument("--observe", action="store_true")
    ap.add_argument("--paranoid", action="store_true"); ap.add_argument("--status", action="store_true")
    ap.add_argument("--write-config", action="store_true")
    ap.add_argument("--authorize", metavar="VID:PID",
                    help="write authorized=1 for one device, then exit")
    ap.add_argument("--descriptors", choices=["none","summary","full"],
                    help="how much descriptor detail the monitor and --inspect print "
                         "(default summary). This is a level for those views; to deep-dive "
                         "one device use --describe instead")
    ap.add_argument("--arm", action="store_true", help="apply protections and exit, they persist")
    ap.add_argument("--disarm", action="store_true", help="release every protection and exit")
    ap.add_argument("--diagnose", action="store_true", help="why did nothing appear")
    ap.add_argument("--inspect", nargs="?", const=True, metavar="VID:PID")
    ap.add_argument("--capture", metavar="VID:PID",
                    help="read what a HID device types WITHOUT letting it reach the system")
    ap.add_argument("--iface", type=int, default=0)
    ap.add_argument("--endpoint", type=lambda x: int(x,0), default=0x81)
    ap.add_argument("--interval", type=float)
    # POLICY: what is trusted.
    ap.add_argument("--allow-existing", "-A", action="store_true",
                    help="add everything currently attached to the allow list")
    ap.add_argument("--allow", dest="allow_list", action="append", metavar="VID:PID",
                    default=[], help="allow one device, repeatable")
    # DISPLAY: what is shown. Deliberately independent of policy.
    ap.add_argument("--hide-allowed", "-H", action="store_true",
                    help="do not print devices that are on the allow list")
    # A level, not a switch. Existing `if a.quiet` tests still work: count is 0 when the
    # flag is absent. -q drops the hints, -qq drops the furniture too, so `--list -qq`
    # pipes into cut and awk without anything to strip first.
    ap.add_argument("--quiet", "-q", action="count", default=0,
                    help="less output. In the monitor: allow what is attached and hide it. "
                         "With --list: -q drops the hint line, -qq drops the header too")
    ap.add_argument("--auto", action="store_true",
                    help="act on arrivals: record what a HID device types (needs root)")
    ap.add_argument("--plain", action="store_true",
                    help="no pinned status block, just scrolling output")
    ap.add_argument("--porcelain", action="store_true",
                    help="stable tab-separated records for scripts, no colour or layout")
    ap.add_argument("--replay", metavar="FILE",
                    help="render a --log file back, same events the viewer sees")
    ap.add_argument("--log", metavar="FILE",
                    help="append the event stream to FILE as ndjson, 0600")
    ap.add_argument("--list", action="store_true", dest="list_devices",
                    help="every device with its low-level addresses, then exit")
    ap.add_argument("--attach", action="store_true",
                    help="watch a monitor that is already running, read-only")
    # --describe, not --verbose. This takes a device and prints a report; it is a mode
    # like --inspect and --hid, not a verbosity level. Named --verbose it both read as a
    # modifier ("--list --verbose") and held -v hostage from --version, and the author of
    # the flag still tripped over it. The old spelling keeps working.
    ap.add_argument("--describe", "--verbose", dest="describe", metavar="ADDR",
                    help="every descriptor of one device, decoded, then exit")
    ap.add_argument("--version", "-V", action="store_true",
                    help="print the version, then exit")
    ap.add_argument("--hid", metavar="ADDR",
                    help="dump the HID report descriptors of one device, then exit")
    ap.add_argument("--forget", action="store_true",
                    help="clear the shared allow list, then exit")
    ap.add_argument("--force", action="store_true",
                    help="start a second monitor anyway, even though one holds the lock")
    ap.add_argument("-h","--help", action="store_true")
    for name in protect.REGISTRY:
        flag = name.replace("_","-")
        ap.add_argument(f"--{flag}", dest=name, action="store_true", default=None)
        ap.add_argument(f"--no-{flag}", dest=name, action="store_false")
    a = ap.parse_args()

    if a.version: p(f"usbairlock {VERSION}"); return 0
    if a.help: p(__doc__); return 0
    if a.write_config: print(cfgmod.sample()); return 0

    cfg, cfg_path = cfgmod.load(a.config)
    if a.descriptors: cfg["monitor"]["descriptors"] = a.descriptors
    if a.interval:    cfg["monitor"]["poll_interval"] = a.interval
    if a.paranoid:
        for k in protect.REGISTRY: cfg["protections"][k] = True
        cfg["protections"]["usbfs_snoop"] = False      # too loud to be a default even here
    for name in protect.REGISTRY:
        v = getattr(a, name, None)
        if v is not None: cfg["protections"][name] = v
    if a.observe:
        for k in cfg["protections"]: cfg["protections"][k] = False

    if a.authorize:
        if not protect.is_root(): p(f"  {C['R']}--authorize needs root{C['N']}"); return 1
        hits = usbinfo.resolve(a.authorize)
        if not hits:
            p(f"  {C['R']}no device matching {a.authorize}{C['N']}")
            p(f"  {C['D']}./usbairlock --list shows every address{C['N']}")
            return 1
        if len(hits) > 1:
            # vid:pid names a MODEL. Say so rather than acting on one and staying quiet.
            p(f"  {C['Y']}{a.authorize} matches {len(hits)} devices{C['N']} "
              f"{C['D']}({', '.join(usbinfo.addr_of(h) for h in hits)}), authorizing all{C['N']}")
            p(f"  {C['D']}address one of them instead to be specific{C['N']}")
        done = []
        for h in hits:
            done += protect.authorize(path=h)
        p(f"  authorized {len(done)} device(s): {' '.join(done) or 'none matched'}")
        # Authorising writes sysfs, which a running monitor sees on its next poll.
        # The ALLOW LIST is separate: it is policy, and without recording it there the
        # monitor would withhold this same device again on the next replug.
        if done and ipc.append_allow([a.authorize]):
            pid = ipc.holder_pid()
            p(f"  {C['D']}added to the shared allow list"
              + (f", monitor pid {pid} notified" if pid and pid > 0 else "")
              + f"{C['N']}")
        return 0 if done else 1
    if a.describe: return do_describe(a.describe)
    if a.hid: return do_hid(a.hid, a.porcelain)
    if a.forget: return do_forget(a.porcelain)
    if a.replay: return do_replay(a, a.replay)
    if a.list_devices: return do_list(a)
    if a.attach: return do_attach(a)
    if a.status: return do_status(a.porcelain)
    if a.diagnose: return do_diagnose(a.porcelain)
    if a.disarm: return do_arm(cfg, disarm=True, porc=a.porcelain)
    if a.arm: return do_arm(cfg, porc=a.porcelain)
    if a.inspect: return do_inspect(cfg, None if a.inspect is True else a.inspect, a.porcelain)
    if a.capture: return do_capture(cfg, a.capture, a.iface, a.endpoint, None)

    # SINGLE INSTANCE. Two monitors would both apply protections and both register
    # cleanup handlers over the same sysfs knobs, so whichever exits first restores them
    # while the other still believes it is holding. Nothing reports that, and it leaves
    # the machine in exactly the state this tool exists to prevent.
    # SIGUSR1 asks us to re-read the allow list now rather than on the next tick. The
    # handler goes in BEFORE the lock, because acquire() publishes our pid and the
    # default action for SIGUSR1 is to terminate. An --authorize landing in the gap
    # between publishing the pid and installing the handler would kill the monitor and
    # lift the gate, which is the one failure this whole file is meant to prevent.
    reread = [False]
    def _on_usr1(signum=None, frame=None): reread[0] = True    # set a flag, nothing more
    try: signal.signal(signal.SIGUSR1, _on_usr1)
    except (OSError, ValueError): pass

    holder = ipc.Holder()
    if not holder.acquire():
        other = ipc.holder_pid()
        where = f" {C['D']}(pid {other}){C['N']}" if other and other > 0 else ""
        if not a.force:
            p(f"  {C['R']}a monitor is already running{C['N']}{where}")
            p(f"  {C['D']}watch it:  sudo ./usbairlock --attach{C['N']}")
            p(f"  {C['D']}override:  --force, only if you are sure the other one is wedged{C['N']}")
            return 1
        if a.porcelain:
            porcelain("forced", other_pid=(other or 0),
                      warn="two monitors share the kernel settings; the first to exit restores them")
        else:
            p(f"  {C['Y']}--force: starting a second monitor while another holds the lock{where}.{C['N']}")
            p(f"  {C['Y']}whichever exits first restores the shared kernel settings for both.{C['N']}")

    # Tell the protection layer what to leave alone before it unbinds anything.
    _snap0 = usbinfo.snapshot()
    protect.SKIP = set(_snap0[k]["id"] for k in _snap0) if (a.allow_existing or a.quiet) \
                   else set(a.allow_list)
    results = protect.apply(cfg["protections"]) if not a.observe else \
              [(n, False, None, d) for n,(f,d) in protect.REGISTRY.items()]
    protect.install_handlers(
        (lambda n: porcelain("restored", settings=n)) if a.porcelain
        else (lambda n: p(f"\n  {C['D']}restored {n} kernel setting(s).{C['N']}")))
    holder.serve()
    protect.add_cleanup(holder.close)
    journal = None
    if a.log:
        journal = ipc.Journal(a.log)
        protect.add_cleanup(journal.close)
        if journal.reason:
            p(f"  {C['R']}cannot log to {a.log}: {journal.reason}{C['N']}")
            journal = None
        else:
            journal.write("session", path=a.log, pid=os.getpid(),
                          protections=[n for n, w, ok, _ in results if w and ok],
                          argv=" ".join(sys.argv[1:]))

    if a.porcelain:
        for name, wanted, ok, detail in results:
            porcelain("protection", name=name, wanted=int(bool(wanted)),
                      active=int(bool(ok)) if wanted else 0)
    else:
        banner(cfg, results, cfg_path, a.observe)
    capturing, capq, stop_all = {}, queue.Queue(), threading.Event()
    typebuf, lastkey = {}, {}
    seen = usbinfo.snapshot()
    # The ALLOW LIST is policy: these devices are trusted, so they are neither held nor
    # captured. Keyed on vid:pid and persistent, which is the point: a device unplugged
    # and replugged is still the same trusted device.
    #
    # HIDING is display, and it keys off the allow list rather than a startup snapshot.
    # A device that was merely hidden at startup reappears when replugged, because
    # nothing ever trusted it. Collapsing the two made the tool lie about which applied.
    allow = set(a.allow_list)
    allow |= set(str(cfg.get("allow", {}).get("devices", "")).replace(",", " ").split())
    if a.allow_existing or a.quiet:
        allow |= set(m["id"] for m in seen.values())
    hide_allowed = bool(a.hide_allowed or a.quiet)   # quiet is a count now, not a flag
    # The shared allow list lives in /run and is re-read every tick, so an --authorize
    # run in another terminal lands here without restarting the monitor. SIGUSR1 only
    # makes that happen immediately instead of within one poll interval.
    allow |= ipc.read_allow()
    allow_stamp = [ipc.allow_mtime()]

    shown = 0
    for k, m in sorted(seen.items()):
        if journal is not None:
            # Every device, including hidden ones. A log filtered by display preference
            # is not a record of what was attached, and the baseline is the half of a
            # forensic log you cannot reconstruct afterwards.
            d0 = usbinfo.descriptors(m["id"])
            journal.write("present", addr=usbinfo.addr_of(m.get("sysfs")), id=m["id"],
                          name=m.get("name") or "", authorized=m.get("authorized"),
                          hidden=bool(hide_allowed and m["id"] in allow),
                          allowed=bool(m["id"] in allow),
                          drivers=",".join(d0.get("drivers") or []) or "none",
                          worst=usbinfo.rules.worst(
                              set(l for l, _, _ in usbinfo.threats(d0))) or "none")
        if hide_allowed and m["id"] in allow:
            continue
        if a.porcelain:
            d0 = usbinfo.descriptors(m["id"])
            th = usbinfo.threats(d0)
            # addr first, and always. --status and --inspect already emit it on these
            # record kinds; the monitor did not, so the SAME record name carried
            # different fields depending on which mode produced it. With two identical
            # devices attached the monitor's records were byte-identical and a consumer
            # could not tell which one had arrived -- proven with two CH340 boards.
            porcelain("present", addr=usbinfo.addr_of(m.get("sysfs")) or "-",
                      id=m["id"], name=(m["name"] or "").replace("\t", " "),
                      drivers=",".join(d0.get("drivers") or []) or "none",
                      worst=usbinfo.rules.worst(set(l for l, _, _ in th)) or "none")
        else:
            show_device(m["id"], m["name"], cfg, meta=m)
        shown += 1
    if allow:
        hid = len(seen) - shown
        # Name them. A bare count was the only warning that a device would not be
        # captured this session, and the list persists in /run across monitor restarts,
        # so "allow list: 1 device(s)" was easy to read past while a HIGH keyboard sat
        # there untouched. Say which, and say that it came from somewhere else.
        carried = " ".join(sorted(allow))
        p(f"  {C['Y']}allow list{C['N']} {C['D']}(persists in /run until reboot, "
          f"clear with --forget){C['N']}")
        p(f"    {C['W']}{carried}{C['N']}"
          + (f"  {C['D']}{hid} hidden{C['N']}" if hide_allowed and hid else ""))

    # --porcelain means machine-only. These three were printed into it as prose, so
    # anything parsing the stream hit three unparseable lines before the first record.
    if a.porcelain:
        if journal is not None:
            porcelain("logging", path=a.log, mode="0600")
        porcelain("watching", interval=cfg["monitor"]["poll_interval"])
    else:
        if journal is not None:
            p(f"  {C['D']}logging to {a.log}, mode 0600. it records what devices type.{C['N']}")
        p(f"  {C['D']}watching. ctrl-c to stop and restore.{C['N']}")
        rule()

    interval = float(cfg["monitor"].get("poll_interval", 1.0))
    prev_serial = set(glob.glob("/dev/ttyACM*") + glob.glob("/dev/ttyUSB*"))
    started, counts = time.time(), {"arrived": 0, "high": 0, "med": 0}
    # Keystrokes arrive one report at a time but read as a sentence. Buffer per device
    # and flush on a newline or a pause, so a payload prints as the line it typed.
    active = [n for n, w, ok, _ in results if w and ok]
    gating = any(n in ("withhold_device", "withhold_interface") for n in active)

    # A pinned block below a normal scrolling region, the apt / docker-pull shape.
    # Not a full-screen TUI on purpose: scrollback survives and the log stays copyable.
    with livemod.Pinned(height=5, enabled=not a.plain) as pin:
        # Every user-visible line already funnels through emit, so wrapping it once is
        # the whole broadcast layer. Viewers see exactly what the holder's terminal sees.
        emit = ipc.tee(pin.log if pin.enabled else _p, holder, journal)
        last_status = []

        def status(last=""):
            gate = (f"{C['G']}WITHHELD{C['N']} " + ", ".join(active)) if active \
                   else f"{C['Y']}GRANTED{C['N']}  drivers bind normally"
            watching = f"   viewers {holder.viewers}" if holder.viewers else ""
            lines = [
                C["D"] + "-" * 76 + C["N"],
                f" {C['W']}usbairlock{C['N']}   {gate}",
                f" devices {len(seen):<3} arrived {counts['arrived']:<3} "
                f"{C['R']}high {counts['high']}{C['N']}  {C['Y']}med {counts['med']}{C['N']}"
                f"   serial {len(prev_serial)}   up {int(time.time()-started)}s{watching}",
                f" {C['D']}{last[:72]}{C['N']}",
                f" {C['D']}ctrl-c stops and restores every kernel change{C['N']}",
            ]
            last_status[:] = lines
            if pin.enabled: pin.set(lines)
            holder.broadcast("status", lines=lines)
        status("waiting for a device")

        while True:
            time.sleep(interval)
            holder.pump(hello={"ev": "status", "lines": last_status} if last_status else None)
            if reread[0] or ipc.allow_mtime() != allow_stamp[0]:
                reread[0], allow_stamp[0] = False, ipc.allow_mtime()
                fresh = ipc.read_allow() - allow
                if fresh:
                    allow |= fresh
                    protect.SKIP |= fresh     # so a replug is not withheld again
                    emit(f"  {time.strftime('%H:%M:%S')}  {C['G']}+ allowed{C['N']}  "
                         f"{' '.join(sorted(fresh))}  {C['D']}another process authorized this{C['N']}")
                    # Releasing matters as much as exempting. A capture holds the
                    # interface through usbfs and keeps usbhid detached, so a device
                    # allowed while being captured stayed dead: admitted on paper,
                    # still unusable. SKIP alone only helped if you unplugged it.
                    for vp_ in sorted(fresh):
                        for ck in _drop_capture(capturing, vp_, release=True):
                            emit(f"  {time.strftime('%H:%M:%S')}  {C['G']}  released{C['N']}  "
                                 f"{ck}  {C['D']}capture stopped, drivers rebinding{C['N']}")
                    status(f"allow list now {len(allow)} device(s)")
            now = usbinfo.snapshot()

            # Reconcile, do not sequence. An allowed device must end up authorized, and
            # there were two ways it did not:
            #   - releasing a capture calls prepare()'s restore(), which puts back the
            #     values recorded BEFORE the capture authorized anything -- i.e. 0. So
            #     --authorize granted trust and the release immediately revoked it.
            #   - SKIP only spares a device from being UNBOUND (protect.py). It says
            #     nothing about the root-hub gate, so an allowed device that is replugged
            #     still enumerates unauthorized, and the arrival line said it was left
            #     alone, which meant nobody authorized it either.
            # Both are the same mistake: trying to get an ordering right instead of
            # stating the invariant. Checking it every tick is idempotent and cannot be
            # raced by a capture thread winding down on its own schedule.
            reconciled = False
            for k, m_ in sorted(now.items()):
                if m_["id"] in allow and m_.get("authorized") == "0":
                    if protect.authorize(path=m_.get("sysfs")):
                        reconciled = True
                        emit(f"  {time.strftime('%H:%M:%S')}  {C['G']}  authorized{C['N']}  "
                             f"{usbinfo.addr_of(m_.get('sysfs')) or m_['id']}  "
                             f"{C['D']}on the allow list, drivers binding{C['N']}")
            if reconciled:
                # Re-read, or the arrival below renders a device we JUST authorized as
                # "UNAUTHORIZED authorized=0" while also reporting the driver that only
                # a successful authorization could have bound. The descriptors are read
                # live and the snapshot is not, so the two disagreed inside one block.
                # A security tool that contradicts itself in its own output is worse
                # than one that says nothing.
                now = usbinfo.snapshot()

            # Departures BEFORE arrivals. seen is keyed by bus/dev, so a device that
            # re-enumerates inside one poll interval is a vanished key plus a new one.
            # Processing arrivals first reported the new devnum before the old one
            # left, so the output read 'arrived, arrived, removed' for one device that
            # had simply reset -- and worse, the arrival branch saw its own address
            # still in `capturing`, skipped starting a capture, and then the departure
            # branch dropped the entry. Net result: device present, nothing capturing
            # it, and no future arrival to restart it. Seen on a dock, 2026-08-22.
            for k in sorted(set(seen) - set(now)):
                if hide_allowed and seen[k]["id"] in allow:
                    continue          # hidden on arrival, hidden on departure
                # Departures existed only as pretty text, so a consumer of --porcelain
                # watched devices arrive and never leave. Anything tracking live state
                # from the machine stream drifted permanently after the first unplug.
                if a.porcelain:
                    porcelain("removed", addr=usbinfo.addr_of(seen[k].get("sysfs")) or "-",
                              id=seen[k]["id"],
                              name=(seen[k]["name"] or "").replace("\t", " "))
                else:
                    emit(f"  {time.strftime('%H:%M:%S')}  {C['Y']}- removed{C['N']}  "
                         f"{seen[k]['id']}  {seen[k]['name']}")
            for k in sorted(set(now) - set(seen)):
                vp0 = now[k]["id"]
                if hide_allowed and vp0 in allow:
                    continue          # `seen` is reassigned once, after the loop
                counts["arrived"] += 1
                if a.porcelain:
                    d = usbinfo.descriptors(vp0)
                    th = usbinfo.threats(d)
                    _a0 = usbinfo.addr_of(now[k].get("sysfs")) or "-"
                    porcelain("arrived", addr=_a0, id=vp0,
                              name=(now[k]["name"] or "").replace("\t", " "),
                              drivers=",".join(d.get("drivers") or []) or "none",
                              worst=usbinfo.rules.worst(set(l for l, _, _ in th)) or "none")
                    for lvl, headline, _ in th:
                        porcelain("threat", addr=_a0, id=vp0, level=lvl, claim=headline)
                else:
                    d = show_device(vp0, now[k]["name"], cfg,
                                    first_seen=True, meta=now[k], out=emit)
                lv = set(l for l, _, _ in usbinfo.threats(d))
                if "HIGH" in lv:
                    counts["high"] += 1
                    # Same meaning as --inspect: something scored HIGH this session.
                    # The signal path calls os._exit, so it has to be recorded now.
                    protect.set_exit_code(2)
                elif "MED" in lv: counts["med"] += 1
                vp = now[k]["id"]
                # Independent of the branch below, deliberately. This device enumerated
                # unauthorized because our gate was down, and the kernel copies
                # authorized_default in once, at enumeration time, so restoring the gate
                # on exit will not revive it. Record it now or it stays dead after we
                # quit. Folding this into the elif chain below would also stop --auto
                # ever reaching its capture branch.
                addr0 = usbinfo.addr_of(now[k].get("sysfs"))
                if gating and now[k].get("authorized") == "0":
                    protect.note_withheld(now[k].get("sysfs"))
                if vp in allow:
                    emit(f"                 {C['D']}on the allow list, admitted without recording{C['N']}")
                elif a.auto and _hid_interfaces(d) and (addr0 or vp) not in capturing:
                    if not protect.is_root():
                        emit(f"                 {C['Y']}--auto needs root, skipping{C['N']}")
                    else:
                        capturing[addr0 or vp] = _start_capture(
                            vp, d, capq, stop_all, target=addr0)
                        if a.porcelain:
                            porcelain("capturing", addr=addr0 or "-", id=vp)
                        else:
                            emit(f"                 {C['M']}{C['W']}capturing{C['N']}"
                                 f"  {C['D']}reports read directly from the endpoint{C['N']}")
                status(f"last arrival: {vp}  {now[k]['name'][:40]}")
            cur_serial = set(glob.glob("/dev/ttyACM*") + glob.glob("/dev/ttyUSB*"))
            for sp in sorted(cur_serial - prev_serial):
                if a.porcelain:
                    porcelain("serial", state="appeared", node=sp)
                else:
                    emit(f"  {time.strftime('%H:%M:%S')}  {C['G']}+ serial{C['N']}   {sp}   {C['D']}./tools/identify {sp}{C['N']}")
            for sp in sorted(prev_serial - cur_serial):
                if a.porcelain:
                    porcelain("serial", state="gone", node=sp)
                else:
                    emit(f"  {time.strftime('%H:%M:%S')}  {C['Y']}- serial{C['N']}   {sp}")
            seen, prev_serial = now, cur_serial

            while True:
                try: kind, vp, payload = capq.get_nowait()
                except queue.Empty: break
                if kind == "keys":
                    typebuf[vp] = typebuf.get(vp, "") + payload
                    lastkey[vp] = time.time()
                # The capture events were the last prose left in the machine stream.
                # --observe can never capture anything, so the porcelain test could not
                # reach this path and did not catch it: a real HID arrival was needed.
                elif kind == "chord":
                    if a.porcelain: porcelain("chord", id=vp, keys=payload)
                    else: emit(f"  {time.strftime('%H:%M:%S')}  {C['R']}{C['W']}CHORD{C['N']}   "
                               f"{C['D']}{vp}{C['N']}  {payload}")
                elif kind == "note":
                    if a.porcelain:
                        porcelain("capture_note", id=vp, note=str(payload))
                    else:
                        col = C['Y'] if str(payload).startswith(("NOTE", "WARNING")) else C['D']
                        emit(f"  {time.strftime('%H:%M:%S')}  {C['Y']}capture{C['N']} {col}{vp} {payload}{C['N']}")
                elif kind == "gone":
                    if a.porcelain:
                        porcelain("capture_end", id=vp, reason=(
                            "left before capture" if "before capture" in str(payload) else "unplugged"))
                    else:
                        emit(f"  {time.strftime('%H:%M:%S')}  {C['D']}capture ended{C['N']} "
                             f"{C['D']}{vp} {payload if 'before capture' in payload else 'unplugged'}{C['N']}")
                    _drop_capture(capturing, vp)
                elif kind == "err":
                    if a.porcelain: porcelain("capture_error", id=vp, error=str(payload))
                    else: emit(f"  {time.strftime('%H:%M:%S')}  {C['R']}capture failed{C['N']} {C['D']}{vp} {payload}{C['N']}")
                    _drop_capture(capturing, vp)
            # flush a device's buffer on a newline, or after it goes quiet
            for vp in list(typebuf):
                buf = typebuf[vp]
                quiet = time.time() - lastkey.get(vp, 0) > 1.2
                if "\n" in buf:
                    *done, rest = buf.split("\n")
                    for line in done:
                        if a.porcelain:
                            porcelain("typed", id=vp, enter=1, text=line)
                        else:
                            emit(f"  {time.strftime('%H:%M:%S')}  {C['C']}{C['W']}TYPED{C['N']}   "
                                 f"{C['D']}{vp}{C['N']}  {line}{C['D']}<ENTER>{C['N']}")
                    typebuf[vp] = rest
                elif quiet and buf:
                    if a.porcelain:
                        porcelain("typed", id=vp, enter=0, text=buf)
                    else:
                        emit(f"  {time.strftime('%H:%M:%S')}  {C['C']}{C['W']}TYPED{C['N']}   "
                             f"{C['D']}{vp}{C['N']}  {buf}")
                    typebuf[vp] = ""
            live_txt = "".join(typebuf.values())[-40:]
            status((f"capturing {len(capturing)}" + (f"   >{live_txt}" if live_txt else ""))
                   if capturing else "")

try:
    _rc = main()
except BrokenPipeError:
    # `--list --porcelain | head` closes the pipe under us. Python turns SIGPIPE into
    # an exception rather than killing the process, so without this a normal shell
    # pipeline ends in a traceback. Setting SIGPIPE to SIG_DFL instead would be the
    # usual fix and is wrong here: the viewer socket writes would then take the signal
    # and kill the monitor when a viewer detaches.
    try:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    except OSError:
        pass
    _rc = 0
except KeyboardInterrupt:
    _rc = 130
sys.exit(_rc)
